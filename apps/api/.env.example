# Copy to apps/api/.env (gitignored). All settings are optional in development.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/hvac_studio
# Tests use TEST_DATABASE_URL (default: .../hvac_studio_test).
# TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/hvac_studio_test

# REQUIRED outside development: a long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# If unset, a built-in dev key is used and a loud warning is logged; ENVIRONMENT=production refuses to start.
SECRET_KEY=

# Session cookie
COOKIE_SECURE=false        # true behind HTTPS
SESSION_TTL_DAYS=7
# COOKIE_DOMAIN=

# Auth rate limiting (per IP + email)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Uploads
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400
MAX_BUILDING_BODY_BYTES=5242880

# Only needed if the web app is served from a different origin (the default setup uses Next rewrites).
# CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
